{
  "manifest_version": 3,
  "name": "Breadcrum",
  "version": "1.6.0",
  "description": "Speichere Seiten und Videos direkt in deinem Breadcrum-Bookmarking-Konto. Öffnet externe YouTube-Links direkt ohne Redirect-Warnseite.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "notifications",
    "contextMenus",
    "tabs"
  ],
  "host_permissions": [
    "https://breadcrum.net/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": ["lib/browser-polyfill.min.js", "background.js"]
  },
  "action": {
    "default_title": "Breadcrum – Speichern",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  },
  "commands": {
    "save-page": {
      "suggested_key": {
        "default": "Alt+Shift+B"
      },
      "description": "Aktuelle Seite zu Breadcrum speichern"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": ["lib/browser-polyfill.min.js", "sites/youtube.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "breadcrum-extension@breadcrum.net",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["websiteContent", "websiteActivity"]
      }
    }
  }
}
