<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="save_clipboard"
        android:enabled="true"
        android:icon="@drawable/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_save_clipboard_short"
        android:shortcutLongLabel="@string/shortcut_save_clipboard_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="de.stegmann.breadcrum"
            android:targetClass="de.stegmann.breadcrum.SaveClipboardActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="open_toread"
        android:enabled="true"
        android:icon="@drawable/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_toread_short"
        android:shortcutLongLabel="@string/shortcut_toread_long">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="de.stegmann.breadcrum"
            android:targetClass="de.stegmann.breadcrum.MainActivity"
            android:data="https://breadcrum.net/bookmarks?toread=true" />
    </shortcut>
</shortcuts>
